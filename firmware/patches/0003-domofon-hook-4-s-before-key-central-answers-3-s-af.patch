From 0566acc3df2f79dba9097b2acd3d2a40c345d766 Mon Sep 17 00:00:00 2001
From: builder <builder@lab>
Date: Wed, 11 Nov 2026 15:46:48 +0000
Subject: [PATCH 3/5] domofon: hook 4 s before key (central answers ~3 s after
 hook)

---
 src/board_lyws03mmc.h | 2 +-
 src/version_cfg.h     | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/board_lyws03mmc.h b/src/board_lyws03mmc.h
index c522713..6db5fe4 100644
--- a/src/board_lyws03mmc.h
+++ b/src/board_lyws03mmc.h
@@ -18,7 +18,7 @@
 #define DEF_OCCUPANCY_DELAY		3	// sec, ring held this long after last LED pulse
 #define DEF_OCCUPANCY_THRES		0
 #define DOMOFON_FAST_POLL_SEC	60	// fast polling after ring
-#define DOMOFON_HOOK_PRE_MS		2000
+#define DOMOFON_HOOK_PRE_MS		4000
 #define DOMOFON_KEY_MS			4000
 #define DOMOFON_HOOK_POST_MS	500
 #define DOM_GPIO_HOOK			GPIO_PC4	// pcb "P9"
diff --git a/src/version_cfg.h b/src/version_cfg.h
index 6d348ec..a753005 100644
--- a/src/version_cfg.h
+++ b/src/version_cfg.h
@@ -142,7 +142,7 @@
 #define APP_BUILD				0x18	//BCD app build "0.4"
 #elif USE_DOMOFON
 #define APP_RELEASE				0x20	// domofon fork 20.00 (above devbis 11.00)
-#define APP_BUILD				0x01
+#define APP_BUILD				0x02
 #else
 #define APP_RELEASE				0x01	//BCD app release "0.1"
 #define APP_BUILD				0x40	//BCD app build "3.9"
-- 
